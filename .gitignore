/target
# The Rust probe under probes/ is its own workspace, so the rooted rule above does
# not reach its build directory. Its Cargo.lock IS committed: the probe measures a
# specific binding version's marshalling, so a floating lock would change the subject.
probes/binding-shape-rs/target/
# Windows packaging output: the staged runtime tree and the compiled installer,
# both regenerated by packaging/windows/stage.ps1 + scribobulate.iss.
/build
/git.commit.txt
/.claude/settings.local.json
.agents/skills
.claude/skills
.idea
*.log
tests/reports
docs
.claude/agents/

# macOS Finder metadata (created by any Finder visit to the tree)
.DS_Store
git.commit.txt
